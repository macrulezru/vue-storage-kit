{
  "name": "vue-storage-kit",
  "version": "0.1.0",
  "description": "Reactive unified storage layer for Vue 3 — localStorage, sessionStorage, IndexedDB, cookies with TTL, encryption, schema migrations, and tab sync",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.mjs",
      "require": "./dist/crypto.cjs"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "import": "./dist/sync.mjs",
      "require": "./dist/sync.cjs"
    },
    "./pinia": {
      "types": "./dist/pinia.d.ts",
      "import": "./dist/pinia.mjs",
      "require": "./dist/pinia.cjs"
    },
    "./compress": {
      "types": "./dist/compress.d.ts",
      "import": "./dist/compress.mjs",
      "require": "./dist/compress.cjs"
    },
    "./nuxt": "./dist/nuxt/module.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "demo": "vite --config vite.demo.config.ts",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "peerDependencies": {
    "pinia": "^2.0.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "pinia": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/kit": "^3.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^2.0.0",
    "@vue/test-utils": "^2.4.0",
    "happy-dom": "^14.0.0",
    "pinia": "^3.0.4",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.4.21",
    "vitest": "^2.0.0",
    "vue": "^3.4.0"
  }
}
